/* Reference 06: persistent hierarchy, preview + agent, full-height module workbench. */
.workbench-six { font-size: 13px; }
.workbench-six .topbar { height: 60px; padding-left: 22px; padding-right: 20px; }
.workbench-six .brand { font-size: 20px; margin-right: 30px; }
.workbench-six .panel { overflow: visible; border-radius: 12px; border-color: rgba(255,255,255,.6); background-color: rgba(0,0,0,0); }
.workbench-six.dark .panel { border-color: rgba(165,193,225,.26); background-color: rgba(0,0,0,0); }
.workbench-six .panel-head { height: 46px; padding-left: 16px; padding-right: 12px; }
.workbench-six .panel-title { font-size: 14px; }
.workbench-six .action { font-size: 12px; min-height: 30px; border-radius: 6px; }
.workbench-six .quiet { background-color: rgba(0,0,0,0); }
.workbench-six.dark .quiet { color: rgb(186,205,230); background-color: rgba(0,0,0,0); }
.workbench-six.dark .muted, .workbench-six.dark .module-subtitle, .workbench-six.dark .small-note, .workbench-six.dark .focus-subtitle { color: rgb(153,175,201); }
.hierarchy-search { margin: 12px 12px 5px 12px; flex-shrink: 0; }
.workbench-six .project-body { flex-grow: 1; min-height: 0; flex-direction: column; }
.workbench-six .hierarchy { position: relative; width: auto; flex-grow: 1; min-height: 0; padding: 0; border-right-width: 0; }
.hierarchy-scroll { flex-grow: 1; min-height: 0; padding: 4px 8px 14px 8px; }
.tree-project { flex-direction: row; align-items: center; margin: 10px 6px 18px 6px; }
.tree-project > DepthMark { margin-right: 8px; scale: 0.75 0.75; }
.tree-project .module-title { font-size: 13px; margin-bottom: 4px; }
.tree-project .muted { font-size: 10px; }
.tree-folder { margin-bottom: 8px; font-size: 12px; }
.tree-folder > Toggle { height: 30px; -unity-font-style: bold; }
.tree-file { font-size: 11px; margin-top: 3px; }
.tree-file > Toggle { min-height: 28px; }
.tree-folder > .unity-foldout__content { margin-left: 7px; }
.tree-file > .unity-foldout__content { margin-left: 5px; border-left-width: 1px; border-left-color: rgba(135,163,198,.18); }
.tree-module { height: 30px; flex-direction: row; align-items: center; margin: 1px 0 1px 5px; padding: 3px 5px; border-width: 1px; border-color: rgba(0,0,0,0); border-radius: 5px; background-color: rgba(0,0,0,0); color: rgb(63,83,116); }
.dark .tree-module { color: rgb(170,188,211); }
.tree-module:hover { background-color: rgba(131,165,216,.12); }
.tree-module.related { color: rgb(66,124,208); }
.dark .tree-module.related { color: rgb(200,221,247); }
.tree-module.selected { border-color: rgba(109,170,249,.5); background-color: rgba(66,139,239,.22); color: rgb(224,241,255); }
.workbench-six .tree-module .role-icon { width: 20px; height: 20px; margin-right: 5px; }
.tree-module-name { font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workbench-six .preview-panel .content { padding: 13px; }
.workbench-six .cart-title { font-size: 27px; margin: 4px 0 13px 0; }
.workbench-six .cart-layout { flex-direction: column; }
.workbench-six .cart-products { width: auto; padding-right: 0; }
.workbench-six .product { height: 78px; flex-wrap: nowrap; margin-bottom: 8px; }
.workbench-six .product-image { width: 70px; height: 78px; margin-right: 12px; background-color: rgba(255,255,255,.85); }
.workbench-six .product-price { margin-left: auto; margin-top: 0; font-size: 14px; }
.workbench-six .product-name { font-size: 13px; }
.workbench-six .product .muted { font-size: 10px; max-width: 155px; }
.workbench-six .cart-summary { flex-grow: 0; padding: 15px; margin-top: 4px; }
.workbench-six .summary-row { height: 29px; }
.workbench-six .total-row { height: 42px; }
.workbench-six .coupon-row { flex-direction: row; flex-wrap: nowrap; margin-top: 13px; }
.workbench-six .coupon-label { width: auto; flex-grow: 1; margin-bottom: 0; padding: 8px; font-size: 11px; }
.workbench-six .coupon-row .primary { width: auto; margin-left: 7px; padding-left: 10px; padding-right: 10px; }
.workbench-six .shop-heading { height: 20px; }
.workbench-six .shop-heading .section-label { font-size: 10px; margin: 0; }
.workbench-six .feed-entry { font-size: 12px; }
.workbench-six .agent-feed { margin: 7px 14px; }
.workbench-six .composer { height: 70px; padding-left: 10px; padding-right: 10px; }
.workbench-six .contextLabel { white-space: normal; }
.workbench-six .focus-header { height: 80px; padding: 14px 20px 8px 20px; }
.workbench-six .feature-heading > .role-icon { width: 42px; height: 42px; margin-right: 12px; }
.workbench-six .focus-title { font-size: 23px; margin-bottom: 6px; }
.workbench-six .focus-subtitle { font-size: 11px; }
.workbench-six .focus-workspace { flex-direction: column; padding: 0 12px 12px 12px; min-height: 0; }
.workbench-six .focus-body { flex-grow: 1; min-height: 0; }
.workbench-six .tabrow { height: 40px; }
.workbench-six .tab { font-size: 12px; }
.composition-scroll { flex-grow: 1; min-height: 0; }
.workbench-six .composition { margin: 0; flex-grow: 0; flex-shrink: 0; min-height: 500px; min-width: 760px; border-width: 0; background-color: rgba(0,0,0,0); overflow: visible; }
.workbench-six .module-card { padding: 13px; border-radius: 11px; background-color: rgba(0,0,0,0); border-width: 1px; border-color: rgba(168,195,229,.6); }
.workbench-six.dark .module-card { background-color: rgba(0,0,0,0); border-color: rgba(172,196,226,.4); }
.workbench-six .module-card.selected { border-width: 1px; border-color: rgb(99,195,255); }
.workbench-six .module-card:hover { border-color: rgb(169,214,250); }
.workbench-six .module-heading { margin-bottom: 10px; flex-shrink: 0; }
.workbench-six .role-icon { width: 38px; height: 38px; margin-right: 9px; }
.workbench-six .module-title { font-size: 14px; margin-bottom: 4px; }
.workbench-six .module-subtitle { font-size: 10px; }
.workbench-six .module-description { font-size: 11px; margin-bottom: 10px; flex-shrink: 0; }
.module-code { font-size: 11px; white-space: normal; background-color: rgba(5,15,31,.65); border-width: 1px; border-color: rgba(133,163,205,.15); border-radius: 6px; color: rgb(166,221,244); padding: 10px; height: 115px; overflow: hidden; flex-shrink: 0; }
.module-property { margin-top: 3px; flex-shrink: 0; }
.module-property .action { margin: 7px 0 0 0; font-size: 11px; }
.inline-property { margin-top: 5px; font-size: 18px; }
.workbench-six .module-foot { flex-direction: row; align-items: center; margin-top: auto; padding-top: 9px; flex-shrink: 0; }
.workbench-six .source-chip { font-size: 10px; margin: 0; padding: 4px 0; background-color: rgba(0,0,0,0); color: rgb(107,138,179); }
.workbench-six.dark .source-chip { color: rgb(147,175,211); background-color: rgba(0,0,0,0); }
.ref-count { margin-left: auto; padding: 3px 5px; border-radius: 4px; background-color: rgba(119,156,218,.13); font-size: 9px; color: rgb(133,163,206); }
.workbench-six .focus-body > .tabrow { height: 34px; padding-left: 12px; border-bottom-width: 0; }
.workbench-six .focus-body > .tabrow .muted { font-size: 10px; }
.workbench-six .inspector-strip { width: auto; height: 190px; min-height: 0; padding: 13px; border-radius: 9px; background-color: rgba(166,185,212,.1); border-color: rgba(174,197,229,.2); flex-shrink: 0; }
.workbench-six.dark .inspector-strip { background-color: rgba(7,16,30,.28); border-color: rgba(146,177,218,.18); }
.inspector-columns { flex-direction: row; align-items: flex-start; }
.inspector-details { width: 27%; padding-right: 14px; }
.inspector-design { width: 37%; padding: 0 16px; border-left-width: 1px; border-left-color: rgba(148,171,201,.14); }
.inspector-references { flex-grow: 1; padding-left: 14px; border-left-width: 1px; border-left-color: rgba(148,171,201,.14); }
.workbench-six .inspector-heading { margin-top: 0; margin-bottom: 4px; }
.workbench-six .inspector-strip .section-label { margin: 2px 0 10px 0; font-size: 10px; }
.workbench-six .inspector-strip .text-body { font-size: 11px; margin-bottom: 8px; }
.workbench-six .inspector-strip .small-note { font-size: 10px; margin-top: 5px; }
.workbench-six .inspector-strip .action { min-height: 27px; font-size: 11px; margin: 5px 0; }
.workbench-six .inspector-strip .role-icon { width: 30px; height: 30px; }
.workbench-six .inspector-strip .module-title { font-size: 12px; }
.evidence-note { margin-top: 10px; font-size: 9px; white-space: normal; color: rgb(100,173,173); }
.reference-row { flex-direction: row; height: 29px; align-items: center; border-width: 0; padding: 3px 0; margin: 1px 0; background-color: rgba(0,0,0,0); color: rgb(131,155,187); }
.reference-row:hover { background-color: rgba(119,158,217,.12); }
.workbench-six .reference-row .role-icon { width: 20px; height: 20px; margin-right: 5px; }
.reference-name { font-size: 10px; overflow: hidden; text-overflow: ellipsis; }
.workbench-six .reviewing .inspector-strip { height: 74px; }
.workbench-six .bottom-status { font-size: 10px; }
.workbench-six .unity-scroller--vertical { width: 5px; min-width: 5px; }
.workbench-six .unity-scroller--horizontal { height: 5px; min-height: 5px; }
.workbench-six #unity-vertical-scroller { width: 6px; min-width: 6px; max-width: 6px; background-color: rgba(0,0,0,0); margin: 0; padding: 0; }
.workbench-six #unity-vertical-scroller #unity-slider { width: 6px; min-width: 6px; max-width: 6px; margin: 0; padding: 0; }
.workbench-six #unity-vertical-scroller #unity-dragger { width: 4px; min-width: 4px; max-width: 4px; margin: 0; border-width: 0; border-radius: 2px; background-color: rgba(137,160,193,.35); }
.workbench-six #unity-horizontal-scroller { height: 6px; min-height: 6px; max-height: 6px; background-color: rgba(0,0,0,0); margin: 0; padding: 0; }
.workbench-six #unity-horizontal-scroller #unity-slider { height: 6px; min-height: 6px; max-height: 6px; margin: 0; padding: 0; }
.workbench-six #unity-horizontal-scroller #unity-dragger { height: 4px; min-height: 4px; max-height: 4px; margin: 0; border-width: 0; border-radius: 2px; background-color: rgba(137,160,193,.35); }
.workbench-six #unity-dragger-border { display: none; }
.workbench-six .unity-scroller__low-button, .workbench-six .unity-scroller__high-button { display: none; }
